{
    "manifest_version": 3,
    "name": "Vocab Library - Flashcards for Language Learners",
    "version": "0.0.1",
    "description": "Select a word on any page, file it into a translated flashcard library, and revise it later.",
    "permissions": [
        "storage",
        "contextMenus"
    ],
    "host_permissions": [
        "https://api.mymemory.translated.net/*"
    ],
    "background": {
        "service_worker": "/src/background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "/src/popup/popup.html",
        "default_icon": {
            "16": "/assets/icons/icon16.png",
            "32": "/assets/icons/icon32.png",
            "48": "/assets/icons/icon48.png",
            "128": "/assets/icons/icon128.png"
        }
    },
    "icons": {
        "16": "/assets/icons/icon16.png",
        "32": "/assets/icons/icon32.png",
        "48": "/assets/icons/icon48.png",
        "128": "/assets/icons/icon128.png"
    }
}